PORT=5000
HOST=localhost
NODE_ENV=development

JWT_SECRET=your_settlex_jwt_secret_key
JWT_EXPIRES_IN=7d

MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/settlex?retryWrites=true&w=majority

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
SMTP_FROM=SettleX <noreply@settlex.com>
DNS_SERVERS=1.1.1.1,1.0.0.1,8.8.8.8,8.8.4.4

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Super Admin Root Credentials
SUPERADMIN_NAME=Suman Sharma
SUPERADMIN_EMAIL=suman.admin@settlex.com
SUPERADMIN_PASSWORD=SuperAdmin123!
